{
  "name": "@alsrjs951/week12-devops",
  "version": "1.0.0",
  "description": "Week 12 — TDD Core Logic, Jest 80%+ Coverage, and Playwright E2E with Screenshot Artifact",
  "main": "src/journal_analyzer.js",
  "scripts": {
    "test": "jest",
    "test:cov": "jest --coverage",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.43.0",
    "jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverage": true,
    "coverageDirectory": "coverage",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/e2e/"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  },
  "author": "alsrjs951",
  "license": "MIT"
}
